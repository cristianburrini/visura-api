# Memory Proxy Configuration

# Connection to the external/remote database (Postgres or MySQL)
# Example Postgres: postgresql://user:password@host:5432/dbname
# Example MySQL: mysql+pymysql://user:password@host:3306/dbname
DATABASE_URL=postgresql://appuser:apppass@localhost:5432/visura_cache

# Upstream Visure API URL
UPSTREAM_API_URL=http://visure-api:8000

# Cache expiration in days (results older than this will be re-fetched)
CACHE_EXPIRATION_DAYS=30

# Log Level
LOG_LEVEL=INFO
